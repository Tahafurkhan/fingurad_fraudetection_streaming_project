# Copy to .env and fill in real values. .env is gitignored; never commit secrets.
#
# Confluent Cloud cluster endpoint, e.g. pkc-xxxxx.<region>.<cloud>.confluent.cloud:9092
BOOTSTRAP_SERVERS=
# Confluent Cloud API key / secret pair with write access to the topic below.
API_KEY=
API_SECRET=

# Kafka topic the producers write to. This MUST match the topic name stored in
# the Databricks secret scope `finguard-scope` under the key
# `kafka_connection_details`, because finguard_streaming/bronze/finguard_bronze.py
# subscribes using that stored value. If the two disagree, the producer writes
# to a topic the pipeline never reads and bronze stays empty.
TOPIC_NAME=

# Generation volume / behaviour (defaults shown; all optional)
TRANSACTIONS_PER_SECOND=5
FRAUD_PERCENTAGE=0.08
TOTAL_CUSTOMERS=1000
TOTAL_MERCHANTS=200
RANDOM_SEED=42
