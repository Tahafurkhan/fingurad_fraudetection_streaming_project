# =============================================================================
# FinGuard - project-level environment template
# =============================================================================
# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Producer settings are separate: kafka_producer/ loads its own .env from that
# package directory. See kafka_producer/.env.example.
# =============================================================================

# --- Databricks workspace ----------------------------------------------------
DATABRICKS_HOST=https://<workspace-id>.cloud.databricks.com
DATABRICKS_CATALOG=finguard
# Personal access token: Settings -> Developer -> Access tokens
DATABRICKS_TOKEN=

# SQL Warehouse HTTP path for dbt / JDBC / ODBC.
# SQL Warehouses -> <warehouse> -> Connection details -> HTTP path
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# --- Postgres (Neon) ---------------------------------------------------------
# Source database for the Lakeflow managed ingestion pipeline that lands
# public.customers into finguard.bronze.customers
# (see ingestion_pipelines/fingurad_ingestion.json).
#
# Databricks authenticates via the Unity Catalog connection instead; these vars
# are for direct access from local tooling.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_SCHEMA=public
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# --- Email alerting ----------------------------------------------------------
# Production reads this from the Databricks secret scope; set here only for
# local testing of notifier logic.
EMAIL_FROM=
GMAIL_APP_PASSWORD=

# --- Databricks secret scope -------------------------------------------------
DATABRICKS_SECRET_SCOPE=finguard-scope
